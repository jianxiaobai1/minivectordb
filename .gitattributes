# The evaluation target is a Linux container. Without these, a checkout on
# Windows with core.autocrlf=true writes CRLF into the shell scripts and the
# Docker build fails on a bad shebang.
* text=auto eol=lf

*.result text eol=lf
*.test   text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sh     text eol=lf
Dockerfile text eol=lf

*.png binary
*.jpg binary

# vector_filter: TopK must be computed inside the WHERE-filtered set,
# never "global top-K then filter" (rule 4), in exact and ann mode alike.

CREATE TABLE f (id BIGINT PRIMARY KEY, g VARCHAR(4), v VECTOR(2));

# Ten near-neighbours that fail the filter, three far rows that pass it.
# A "top-K first, filter after" implementation returns 0 rows here;
# the correct answer is the matching rows themselves.
INSERT INTO f VALUES (1, 'n', [0, 0]), (2, 'n', [0.1, 0]), (3, 'n', [0, 0.1]), (4, 'n', [0.1, 0.1]), (5, 'n', [0.2, 0]), (6, 'n', [0, 0.2]), (7, 'n', [0.2, 0.2]), (8, 'n', [0.3, 0]), (9, 'n', [0.15, 0.1]), (10, 'n', [0.1, 0.15]);
INSERT INTO f VALUES (101, 'm', [10, 0]), (102, 'm', [0, 10]), (103, 'm', [9, 9]);

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 2;

# fewer matching rows than K -> return exactly the matches (rule 5)
SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 5;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 3 OFFSET 1;

# filter on the primary key itself
SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE id >= 6 ORDER BY d ASC LIMIT 4;

# range + equality conjuncts
SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'n' AND id >= 6 ORDER BY d ASC LIMIT 3;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'n' AND id < 4 ORDER BY d ASC LIMIT 2;

# empty match set -> no rows at all
SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'z' ORDER BY d ASC LIMIT 2;

# ann mode must produce the identical filtered answers (rule 15)
SET vector_mode = ann;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 2;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 5;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'n' AND id >= 6 ORDER BY d ASC LIMIT 3;

# with an approximate index behind it the filtered answers stay exact
CREATE VECTOR INDEX fix ON f(v);

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 2;

SET vector_mode = exact;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 2;

# a row moved across the filter boundary must join the filtered TopK
UPDATE f SET g = 'm' WHERE id = 1;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 4;

# and a deleted one must leave it
DELETE FROM f WHERE id = 1;

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' ORDER BY d ASC LIMIT 4;

# distance threshold conjunct on top of a scalar filter
SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM f WHERE g = 'm' AND L2_DISTANCE(v, [0, 0]) <= 100 ORDER BY d ASC LIMIT 5;

DROP TABLE f;

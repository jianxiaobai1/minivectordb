# persistence: confirmed writes survive clean restarts, including schema,
# unicode payload, updated/deleted rows and the vector index (rules 11, 13).

CREATE TABLE p (id BIGINT PRIMARY KEY, s VARCHAR(16), v VECTOR(3));

INSERT INTO p VALUES (1, 'alpha', [1, 0, 0]), (2, '中文😀', [0, 1, 0]), (3, 'gamma', [0, 0, 1]);

CREATE VECTOR INDEX pix ON p(v);

SELECT * FROM p ORDER BY id;

SELECT id, L2_DISTANCE(v, [0, 0, 0]) AS d FROM p ORDER BY d ASC LIMIT 3;

# restart

SELECT * FROM p ORDER BY id;

SELECT id, L2_DISTANCE(v, [0, 0, 0]) AS d FROM p ORDER BY d ASC LIMIT 3;

# DML then plain restart
UPDATE p SET s = 'ALPHA', v = [0.5, 0.5, 0] WHERE id = 1;

DELETE FROM p WHERE id = 3;

INSERT INTO p VALUES (4, 'δ', [1, 1, 1]);

BEGIN;
INSERT INTO p VALUES (5, 'txn-committed', [2, 0, 0]);
COMMIT;

# restart

SELECT * FROM p ORDER BY id;

SELECT id, s, L2_DISTANCE(v, [1, 0, 0]) AS d FROM p ORDER BY d ASC LIMIT 2;

# rollbacked work must NOT survive the next restart either
BEGIN;
INSERT INTO p VALUES (6, 'ghost', [0, 0, 0]);
ROLLBACK;

# restart

SELECT id FROM p ORDER BY id;

# schema survives: inserts into the reloaded table behave identically
INSERT INTO p VALUES (7, 'fresh', [0.25, 0.25, 0.25]);

SELECT * FROM p WHERE id = 7;

# a dropped table stays dropped across restart
DROP TABLE p;

# restart

# expect-error NO_SUCH_TABLE
SELECT * FROM p;

# recreating with the same name works and is empty
CREATE TABLE p (id BIGINT PRIMARY KEY, v VECTOR(2));

# restart

SELECT * FROM p;

INSERT INTO p VALUES (1, [3, 4]);

# restart

SELECT id, L2_DISTANCE(v, [0, 0]) AS d FROM p ORDER BY d LIMIT 1;
